# Copy to .env.local and fill in. Only EXPO_PUBLIC_* variables are bundled into the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_...
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....        # optional: without it the map renders empty
EXPO_PUBLIC_SENTRY_DSN=                        # optional

# Build-time only (never EXPO_PUBLIC_)
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID

# Edge Function secrets — set them in the Supabase dashboard, never in this file:
#   SUPABASE_SERVICE_ROLE_KEY, CLERK_SECRET_KEY, OPENAI_API_KEY,
#   ANIMAL_ID_API_URL, ANIMAL_ID_API_TOKEN, REVENUECAT_WEBHOOK_SECRET,
#   ONESIGNAL_APP_ID, ONESIGNAL_API_KEY, RECAP_SECRET
